# Copier en .env n'a aucun effet automatique : ces variables se définissent
# dans l'environnement (tableau de bord Render, ou `export` en local).

# Secret de signature des sessions : obligatoire en production.
JWT_SECRET=remplacer-par-une-longue-chaine-aleatoire

# Port d'écoute de l'API.
PORT=4000

# Dossier contenant tickets.db et uploads/ (disque persistant sur Render).
# DATA_DIR=/var/data

# Origines autorisées à appeler l'API, séparées par des virgules.
# CORS_ORIGIN=https://xchange.onrender.com

# Fermer l'inscription libre (les comptes sont créés par un administrateur).
# ALLOW_REGISTRATION=false

# Compte administrateur créé ou promu au démarrage.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=un-mot-de-passe-solide

# Taille maximale d'une pièce jointe, en Mo.
# MAX_UPLOAD_MB=10

# Notifications par e-mail (facultatif). Exemple avec une boîte Orange :
# SMTP_HOST=smtp.orange.fr
# SMTP_PORT=465
# SMTP_USER=adresse@orange.fr
# SMTP_PASSWORD=
# MAIL_FROM=adresse@orange.fr
# APP_URL=https://xchange.exemple.fr
